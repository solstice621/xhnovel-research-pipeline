{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xhnovel.local/docs/spikes/geography-capacity-stats/geography-gold-dispute.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sample_id",
    "dispute_id",
    "unit_id",
    "category",
    "candidate_label_artifact_ids",
    "resolution",
    "note"
  ],
  "properties": {
    "schema_version": {"const": "geography-gold-dispute/v1"},
    "sample_id": {"const": "GEOGOLD-B-20260904"},
    "dispute_id": {"type": "string", "pattern": "^GEODSP-[A-Z0-9]{20}$"},
    "unit_id": {"type": "string", "pattern": "^XUNIT-[A-Z0-9]{20}$"},
    "category": {
      "enum": ["INCLUSION", "PAYLOAD", "EVIDENCE", "RELATION_SEMANTICS", "SOURCE_TEXT"]
    },
    "candidate_label_artifact_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/sha256"}
    },
    "resolution": {"enum": ["INCLUDED", "EXCLUDED", "UNRESOLVED"]},
    "note": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
