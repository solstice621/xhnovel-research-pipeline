{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xhnovel.local/docs/spikes/geography-capacity-stats/geography-gold-annotation.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sample_id",
    "annotation_id",
    "annotation_state",
    "unit_id",
    "unit_hash",
    "ordinal",
    "occurrence_ordinal",
    "payload",
    "evidence_bindings",
    "unit_position"
  ],
  "properties": {
    "schema_version": {"const": "geography-gold-annotation/v1"},
    "sample_id": {"const": "GEOGOLD-B-20260904"},
    "annotation_id": {"type": "string", "pattern": "^GEOANN-[A-Z0-9]{20}$"},
    "annotation_state": {"enum": ["ANNOTATION_DRAFT", "HUMAN_ACCEPTED"]},
    "unit_id": {"type": "string", "pattern": "^XUNIT-[A-Z0-9]{20}$"},
    "unit_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "ordinal": {"type": "integer", "minimum": 1},
    "occurrence_ordinal": {"type": "integer", "minimum": 1},
    "payload": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "name"],
          "properties": {
            "kind": {"const": "PLACE_MENTION"},
            "name": {"type": "string", "minLength": 1},
            "explicit_type": {"type": "string", "minLength": 1}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "subject_name", "relation", "object_name"],
          "properties": {
            "kind": {"const": "SPATIAL_RELATION"},
            "subject_name": {"type": "string", "minLength": 1},
            "relation": {
              "enum": ["LOCATED_IN", "PART_OF", "NEAR", "OUTSIDE", "CONNECTED_TO"]
            },
            "object_name": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "evidence_bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["paths", "source_spans"],
        "properties": {
          "paths": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^/"}
          },
          "source_spans": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/source_span"}
          }
        }
      }
    },
    "unit_position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "start_fraction", "bucket"],
      "properties": {
        "start": {"type": "integer", "minimum": 0, "maximum": 9999},
        "end": {"type": "integer", "minimum": 1, "maximum": 10000},
        "start_fraction": {"type": "number", "minimum": 0, "exclusiveMaximum": 1},
        "bucket": {"enum": ["Q1", "Q2", "Q3", "Q4"]}
      }
    }
  },
  "$defs": {
    "source_span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["segment_id", "start", "end", "normalized_text_hash"],
      "properties": {
        "segment_id": {"type": "string", "pattern": "^SEG-"},
        "start": {"type": "integer", "minimum": 0},
        "end": {"type": "integer", "minimum": 1},
        "normalized_text_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    }
  }
}
