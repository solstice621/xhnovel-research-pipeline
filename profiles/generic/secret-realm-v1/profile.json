{
  "profile_manifest_version": "extraction-profile/v1",
  "profile_id": "xhnovel.secret-realm",
  "profile_version": "1.0.0",
  "prompt": "prompt.md",
  "payload_schema": "payload.schema.json",
  "schema_name": "xhnovel_secret_realm_v1",
  "unit_policy": {
    "id": "sliding-text/v1",
    "target_chars": 10000,
    "overlap_chars": 1800
  },
  "limits": {
    "max_records_per_unit": 96,
    "max_payload_bytes_per_record": 32768,
    "max_workers": 8
  },
  "evidence_policy": {
    "by_kind": {
      "REALM_MENTION": {
        "required_groups": [["/name"]],
        "exempt_paths": ["/kind"]
      },
      "REALM_ACCESS": {
        "required_groups": [["/realm_name", "/access"]],
        "exempt_paths": ["/kind"]
      },
      "REALM_STAKE": {
        "required_groups": [["/realm_name", "/stake_kind", "/item_name"]],
        "exempt_paths": ["/kind"]
      }
    }
  },
  "reduction": {
    "reducer_id": "exact-payload-dedup/v1",
    "config": {"record_version": 1}
  }
}
