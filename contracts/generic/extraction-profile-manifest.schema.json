{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xhnovel.local/contracts/generic/extraction-profile-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile_manifest_version",
    "profile_id",
    "profile_version",
    "prompt",
    "payload_schema",
    "schema_name",
    "unit_policy",
    "limits",
    "evidence_policy",
    "reduction"
  ],
  "properties": {
    "profile_manifest_version": {"const": "extraction-profile/v1"},
    "profile_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "profile_version": {"type": "string", "minLength": 1},
    "prompt": {"type": "string", "minLength": 1},
    "payload_schema": {"type": "string", "minLength": 1},
    "schema_name": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"},
    "unit_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "target_chars", "overlap_chars"],
      "properties": {
        "id": {"const": "sliding-text/v1"},
        "target_chars": {"type": "integer", "minimum": 1},
        "overlap_chars": {"type": "integer", "minimum": 0}
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_records_per_unit", "max_payload_bytes_per_record", "max_workers"],
      "properties": {
        "max_records_per_unit": {"type": "integer", "minimum": 1, "maximum": 1000},
        "max_payload_bytes_per_record": {"type": "integer", "minimum": 1},
        "max_workers": {"type": "integer", "minimum": 1, "maximum": 64}
      }
    },
    "evidence_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["by_kind"],
      "properties": {
        "by_kind": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["required_groups", "exempt_paths"],
            "properties": {
              "required_groups": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {"type": "string", "pattern": "^/"}
                }
              },
              "exempt_paths": {
                "type": "array",
                "uniqueItems": true,
                "items": {"type": "string", "pattern": "^/"}
              }
            }
          }
        }
      }
    },
    "reduction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reducer_id", "config"],
      "properties": {
        "reducer_id": {"const": "exact-payload-dedup/v1"},
        "config": {
          "type": "object",
          "additionalProperties": false,
          "properties": {"record_version": {"type": "integer", "minimum": 1}}
        }
      }
    }
  }
}
