{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xhnovel.local/contracts/generic/model-attempt-v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "attempt_id", "operation", "subject_kind", "subject_id",
    "extraction_build_id", "task_artifact_id", "request_artifact_id",
    "response_artifact_id", "attempt_ordinal", "status", "http_status",
    "error_code", "error_message", "provider_response_id", "usage", "retry_of",
    "recorded_at"
  ],
  "properties": {
    "schema_version": {"const": "model-attempt/v2"},
    "attempt_id": {"type": "string", "pattern": "^MAT2-[A-Z0-9]{20}$"},
    "operation": {"const": "PROFILE_EXTRACTION"},
    "subject_kind": {"const": "ExtractionUnit"},
    "subject_id": {"type": "string", "pattern": "^XUNIT-[A-Z0-9]{20}$"},
    "extraction_build_id": {"type": "string", "pattern": "^XBLD-[A-Z0-9]{20}$"},
    "task_artifact_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "request_artifact_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "response_artifact_id": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
    "attempt_ordinal": {"type": "integer", "minimum": 1},
    "status": {"enum": ["SUCCEEDED", "RETRYABLE", "FAILED", "REFUSED", "REJECTED"]},
    "http_status": {"type": ["integer", "null"], "minimum": 100, "maximum": 599},
    "error_code": {"type": ["string", "null"]},
    "error_message": {"type": ["string", "null"]},
    "provider_response_id": {"type": ["string", "null"]},
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "total_tokens", "estimated_cost_microusd"],
      "properties": {
        "input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "total_tokens": {"type": ["integer", "null"], "minimum": 0},
        "estimated_cost_microusd": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "retry_of": {"type": ["string", "null"], "pattern": "^MAT2-[A-Z0-9]{20}$"},
    "recorded_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
  }
}
