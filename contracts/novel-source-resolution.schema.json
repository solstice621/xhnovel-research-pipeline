{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xhnovel.local/contracts/novel-source-resolution.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "resolution_id",
    "ranking_run_id",
    "candidate_id",
    "candidate_rank",
    "candidate_title",
    "candidate_score",
    "match_method",
    "matched_selector",
    "source_catalog_entry_index",
    "resolver_build_id",
    "source_catalog_artifact_id",
    "source_spec_artifact_id",
    "source_spec_hash",
    "source_kind",
    "source_locator",
    "status",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2-draft"
    },
    "resolution_id": {
      "type": "string",
      "pattern": "^NSR-[A-Z0-9][A-Z0-9._:-]{1,}$"
    },
    "ranking_run_id": {
      "type": "string",
      "pattern": "^NRNK-[A-Z0-9][A-Z0-9._:-]{1,}$"
    },
    "candidate_id": {
      "type": "string",
      "pattern": "^NCAN-[A-Z0-9][A-Z0-9._:-]{1,}$"
    },
    "candidate_rank": {
      "type": "integer",
      "minimum": 1
    },
    "candidate_title": {
      "type": "string",
      "minLength": 1
    },
    "candidate_score": {
      "type": "integer",
      "minimum": 0
    },
    "match_method": {
      "enum": [
        "CANDIDATE_ID",
        "NORMALIZED_TITLE"
      ]
    },
    "matched_selector": {
      "type": "string",
      "minLength": 1
    },
    "source_catalog_entry_index": {
      "type": "integer",
      "minimum": 0
    },
    "resolver_build_id": {
      "type": "string",
      "minLength": 1
    },
    "source_catalog_artifact_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "source_spec_artifact_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "source_spec_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "source_kind": {
      "enum": [
        "txt",
        "epub",
        "directory",
        "chapter-directory",
        "site",
        "static-site"
      ]
    },
    "source_locator": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "SELECTED"
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
