{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xhnovel.local/contracts/novel-work.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "work_id",
    "title",
    "language",
    "source_kind",
    "source_locator",
    "adapter_build_id",
    "source_artifact_ids",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2-draft"
    },
    "work_id": {
      "type": "string",
      "pattern": "^NWK-[A-Z0-9][A-Z0-9._:-]{1,}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "author": {
      "type": [
        "string",
        "null"
      ]
    },
    "language": {
      "type": "string",
      "minLength": 1
    },
    "source_kind": {
      "enum": [
        "TXT",
        "EPUB",
        "DIRECTORY",
        "SITE"
      ]
    },
    "source_locator": {
      "type": "string",
      "minLength": 1
    },
    "adapter_build_id": {
      "type": "string",
      "minLength": 1
    },
    "source_artifact_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
