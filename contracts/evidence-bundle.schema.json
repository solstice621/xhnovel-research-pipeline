{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xhnovel.local/contracts/evidence-bundle.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bundle_id",
    "request_id",
    "collection_snapshot_ids",
    "document_ids",
    "segment_ids",
    "selection_manifest",
    "profile_id",
    "policy_bundle_hash",
    "bundle_hash",
    "frozen_at",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1-draft-frozen"
    },
    "bundle_id": {
      "type": "string",
      "pattern": "^BND-[A-Z0-9][A-Z0-9._:-]{1,}$"
    },
    "request_id": {
      "type": "string",
      "pattern": "^REQ-[A-Z0-9][A-Z0-9._:-]{1,}$"
    },
    "collection_snapshot_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^SNP-[A-Z0-9][A-Z0-9._:-]{1,}$"
      }
    },
    "document_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^DOC-[A-Z0-9][A-Z0-9._:-]{1,}$"
      }
    },
    "segment_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^SEG-[A-Z0-9][A-Z0-9._:-]{1,}$"
      }
    },
    "retrieval_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^RET-[A-Z0-9][A-Z0-9._:-]{1,}$"
      }
    },
    "artifact_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    },
    "triage_assessment_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^TRI-[A-Z0-9][A-Z0-9._:-]{1,}$"
      }
    },
    "origin_assessment_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^ORI-[A-Z0-9][A-Z0-9._:-]{1,}$"
      }
    },
    "selection_manifest": {
      "type": "object",
      "required": [
        "selected_hit_ids",
        "rejected_hit_ids"
      ],
      "properties": {
        "selected_hit_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^HIT-[A-Z0-9][A-Z0-9._:-]{1,}$"
          },
          "uniqueItems": true
        },
        "rejected_hit_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^HIT-[A-Z0-9][A-Z0-9._:-]{1,}$"
          },
          "uniqueItems": true
        },
        "selected_chapter_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^CHP-[A-Z0-9][A-Z0-9._:-]{1,}$"
          },
          "uniqueItems": true
        },
        "duplicate_chapter_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^CHP-[A-Z0-9][A-Z0-9._:-]{1,}$"
          },
          "uniqueItems": true
        },
        "collection_review_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^CRV-[A-Z0-9][A-Z0-9._:-]{1,}$"
          },
          "uniqueItems": true
        },
        "quality_gate_result": {
          "enum": [
            "PASS",
            "INCONCLUSIVE"
          ]
        }
      },
      "additionalProperties": false
    },
    "profile_id": {
      "type": "string"
    },
    "policy_bundle_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "bundle_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "frozen_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "DRAFT",
        "FROZEN",
        "EXTRACTED",
        "EXPORTED",
        "SUPERSEDED"
      ]
    }
  }
}
