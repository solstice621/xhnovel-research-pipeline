{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xhnovel.local/contracts/search-campaign.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "campaign_id",
    "request_id",
    "planner_build_id",
    "coverage_goals",
    "budget",
    "status",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1-draft-frozen"
    },
    "campaign_id": {
      "type": "string",
      "pattern": "^CAM-[A-Z0-9][A-Z0-9._:-]{1,}$"
    },
    "request_id": {
      "type": "string",
      "pattern": "^REQ-[A-Z0-9][A-Z0-9._:-]{1,}$"
    },
    "planner_build_id": {
      "type": "string",
      "minLength": 1
    },
    "coverage_goals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": true
    },
    "iterations": {
      "type": "integer",
      "minimum": 0
    },
    "stop_policy_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "status": {
      "enum": [
        "DRAFT",
        "RUNNING",
        "COMPLETED",
        "EXHAUSTED",
        "BUDGET_STOPPED",
        "FAILED",
        "CANCELLED"
      ]
    },
    "stop_reason": {
      "enum": [
        "coverage_reached",
        "budget_exhausted",
        "no_new_source",
        "provider_exhausted",
        "manual_stop",
        "failed"
      ]
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
