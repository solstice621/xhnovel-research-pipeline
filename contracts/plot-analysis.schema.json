{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xhnovel.local/contracts/plot-analysis.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "analysis_id",
    "work_id",
    "extraction_run_id",
    "claim_ids",
    "analysis_model",
    "analysis_build_id",
    "analysis_parameters",
    "policy_id",
    "policy_artifact_id",
    "model_request_artifact_id",
    "provider_response_artifact_id",
    "alias_groups",
    "event_groups",
    "timeline",
    "key_events",
    "status",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1-draft-frozen"
    },
    "analysis_id": {
      "type": "string",
      "pattern": "^PAN-[A-Z0-9][A-Z0-9._:-]{1,}$"
    },
    "work_id": {
      "type": "string",
      "pattern": "^NWK-[A-Z0-9][A-Z0-9._:-]{1,}$"
    },
    "extraction_run_id": {
      "type": "string",
      "pattern": "^ERUN-[A-Z0-9][A-Z0-9._:-]{1,}$"
    },
    "claim_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^CLM-[A-Z0-9][A-Z0-9._:-]{1,}$"
      },
      "uniqueItems": true
    },
    "analysis_model": {
      "type": "string",
      "minLength": 1
    },
    "analysis_build_id": {
      "type": "string",
      "minLength": 1
    },
    "analysis_parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "endpoint",
        "max_input_chars",
        "structured_output"
      ],
      "properties": {
        "endpoint": {
          "type": "string",
          "minLength": 1
        },
        "max_input_chars": {
          "type": "integer",
          "minimum": 1
        },
        "structured_output": {
          "const": true
        }
      }
    },
    "policy_id": {
      "const": "plot-analysis-v1"
    },
    "policy_artifact_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "model_request_artifact_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "provider_response_artifact_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "alias_groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "canonical_name",
          "aliases",
          "claim_ids"
        ],
        "properties": {
          "canonical_name": {
            "type": "string",
            "minLength": 1
          },
          "aliases": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "claim_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^CLM-[A-Z0-9][A-Z0-9._:-]{1,}$"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "event_groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "group_key",
          "summary",
          "claim_ids",
          "first_sequence",
          "last_sequence",
          "cross_chapter"
        ],
        "properties": {
          "group_key": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "claim_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^CLM-[A-Z0-9][A-Z0-9._:-]{1,}$"
            },
            "uniqueItems": true
          },
          "first_sequence": {
            "type": "integer",
            "minimum": 1
          },
          "last_sequence": {
            "type": "integer",
            "minimum": 1
          },
          "cross_chapter": {
            "type": "boolean"
          }
        }
      }
    },
    "timeline": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sequence",
          "claim_id",
          "chapter_id",
          "chapter_ordinal",
          "segment_ordinal"
        ],
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "claim_id": {
            "type": "string",
            "pattern": "^CLM-[A-Z0-9][A-Z0-9._:-]{1,}$"
          },
          "chapter_id": {
            "type": "string",
            "pattern": "^CHP-[A-Z0-9][A-Z0-9._:-]{1,}$"
          },
          "chapter_ordinal": {
            "type": "integer",
            "minimum": 1
          },
          "segment_ordinal": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "key_events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "causal_impact",
          "character_change",
          "world_state_change",
          "setup_payoff",
          "rationale",
          "score",
          "timeline_sequence"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "pattern": "^CLM-[A-Z0-9][A-Z0-9._:-]{1,}$"
          },
          "causal_impact": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          },
          "character_change": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          },
          "world_state_change": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          },
          "setup_payoff": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "timeline_sequence": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "status": {
      "const": "SUCCEEDED"
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
