{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xhnovel.local/contracts/collection-snapshot.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_id",
    "campaign_id",
    "search_run_ids",
    "hit_ids",
    "retrieval_ids",
    "artifact_ids",
    "triage_assessment_ids",
    "origin_assessment_ids",
    "snapshot_hash",
    "frozen_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1-draft-frozen"
    },
    "snapshot_id": {
      "type": "string",
      "pattern": "^SNP-[A-Z0-9][A-Z0-9._:-]{1,}$"
    },
    "campaign_id": {
      "type": "string",
      "pattern": "^CAM-[A-Z0-9][A-Z0-9._:-]{1,}$"
    },
    "search_run_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^SRUN-[A-Z0-9][A-Z0-9._:-]{1,}$"
      }
    },
    "hit_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^HIT-[A-Z0-9][A-Z0-9._:-]{1,}$"
      }
    },
    "retrieval_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^RET-[A-Z0-9][A-Z0-9._:-]{1,}$"
      }
    },
    "artifact_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    },
    "triage_assessment_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^TRI-[A-Z0-9][A-Z0-9._:-]{1,}$"
      }
    },
    "origin_assessment_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^ORI-[A-Z0-9][A-Z0-9._:-]{1,}$"
      }
    },
    "snapshot_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "frozen_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "DRAFT",
        "FROZEN"
      ]
    }
  }
}
