{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xhnovel.local/contracts/scene-scout-run.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scene_scout_run_id",
    "request_id",
    "bundle_id",
    "bundle_hash",
    "extractor_build_id",
    "discovery_brief_hash",
    "window_ids",
    "model_request_artifact_ids",
    "provider_response_artifact_ids",
    "checkpoint_artifact_id",
    "checkpoint_hash",
    "resumed_from_checkpoint",
    "model_attempt_ids",
    "attempt_record_artifact_ids",
    "usage_ledger",
    "status",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": "0.2-draft"},
    "scene_scout_run_id": {"type": "string", "pattern": "^SSRUN-[A-Z0-9][A-Z0-9._:-]{1,}$"},
    "request_id": {"type": "string", "pattern": "^REQ-[A-Z0-9][A-Z0-9._:-]{1,}$"},
    "bundle_id": {"type": "string", "pattern": "^BND-[A-Z0-9][A-Z0-9._:-]{1,}$"},
    "bundle_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "extractor_build_id": {"type": "string", "pattern": "^BLD-[A-Z0-9][A-Z0-9._:-]{1,}$"},
    "discovery_brief_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "window_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^SWIN-[A-Z0-9][A-Z0-9._:-]{1,}$"}
    },
    "model_request_artifact_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
    },
    "provider_response_artifact_ids": {
      "type": "array",
      "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
    },
    "checkpoint_artifact_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "checkpoint_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "resumed_from_checkpoint": {"type": "boolean"},
    "model_attempt_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^MAT-[A-Z0-9][A-Z0-9._:-]{1,}$"}
    },
    "attempt_record_artifact_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
    },
    "usage_ledger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "total_tokens", "attempts_with_unknown_usage", "estimated_cost_microusd"],
      "properties": {
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "total_tokens": {"type": "integer", "minimum": 0},
        "attempts_with_unknown_usage": {"type": "integer", "minimum": 0},
        "estimated_cost_microusd": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "status": {"const": "SUCCEEDED"},
    "created_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
  }
}
