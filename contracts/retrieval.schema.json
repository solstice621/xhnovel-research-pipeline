{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xhnovel.local/contracts/retrieval.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "retrieval_id",
    "source_id",
    "requested_url",
    "access_kind",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1-draft-frozen"
    },
    "retrieval_id": {
      "type": "string",
      "pattern": "^RET-[A-Z0-9][A-Z0-9._:-]{1,}$"
    },
    "source_id": {
      "type": "string",
      "pattern": "^SRC-[A-Z0-9][A-Z0-9._:-]{1,}$"
    },
    "discovery_hit_id": {
      "type": "string",
      "pattern": "^HIT-[A-Z0-9][A-Z0-9._:-]{1,}$"
    },
    "requested_url": {
      "type": "string"
    },
    "final_url": {
      "type": "string"
    },
    "access_kind": {
      "type": "string",
      "minLength": 1
    },
    "retrieved_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "http_status": {
      "type": [
        "integer",
        "null"
      ]
    },
    "content_type": {
      "type": "string"
    },
    "fetcher_build_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "QUEUED",
        "FETCHING",
        "FETCHED",
        "BLOCKED",
        "UNREACHABLE",
        "FAILED",
        "NEEDS_RENDERER"
      ]
    },
    "triage_assessment_id": {
      "type": "string",
      "pattern": "^TRI-[A-Z0-9][A-Z0-9._:-]{1,}$"
    },
    "retry_of": {
      "type": [
        "string",
        "null"
      ]
    },
    "post_isolation": {
      "type": "boolean"
    }
  }
}
