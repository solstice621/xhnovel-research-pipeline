{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xhnovel.local/contracts/assurance-record.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "subject_type",
    "subject_id",
    "level",
    "policy_hash",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1-draft-frozen"
    },
    "subject_type": {
      "enum": [
        "BUILD",
        "BUNDLE",
        "EXPORT"
      ]
    },
    "subject_id": {
      "type": "string"
    },
    "level": {
      "enum": [
        "UNQUALIFIED",
        "BUILD_QUALIFIED",
        "BUNDLE_VERIFIED",
        "HUMAN_AUDITED"
      ]
    },
    "policy_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "qualification_run_id": {
      "type": "string",
      "pattern": "^QRUN-[A-Z0-9][A-Z0-9._:-]{1,}$"
    },
    "extraction_run_id": {
      "type": "string",
      "pattern": "^ERUN-[A-Z0-9][A-Z0-9._:-]{1,}$"
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
