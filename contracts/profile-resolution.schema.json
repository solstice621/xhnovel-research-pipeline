{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xhnovel.local/contracts/profile-resolution.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "$ref": "defs.schema.json#/$defs/schema_version"
    },
    "resolution_id": {
      "type": "string",
      "pattern": "^PRES-[A-F0-9]{20}$"
    },
    "resolution_hash": {
      "$ref": "defs.schema.json#/$defs/sha256"
    },
    "definition_artifact_id": {
      "$ref": "defs.schema.json#/$defs/sha256"
    },
    "definition_id": {
      "type": "string",
      "pattern": "^ODEF-[A-F0-9]{20}$"
    },
    "decision": {
      "enum": [
        "REUSE_EXISTING",
        "CREATE_REQUIRED",
        "UNSUPPORTED_BY_LOCAL_EXTRACTION"
      ]
    },
    "selected_profile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile_ref": {
          "type": "string",
          "minLength": 1
        },
        "profile_id": {
          "type": "string",
          "minLength": 1
        },
        "profile_version": {
          "type": "string",
          "minLength": 1
        },
        "package_hash": {
          "$ref": "defs.schema.json#/$defs/sha256"
        },
        "extraction_profile_hash": {
          "$ref": "defs.schema.json#/$defs/sha256"
        },
        "reduction_profile_hash": {
          "$ref": "defs.schema.json#/$defs/sha256"
        }
      },
      "required": [
        "profile_ref",
        "profile_id",
        "profile_version",
        "package_hash",
        "extraction_profile_hash",
        "reduction_profile_hash"
      ]
    },
    "fit": {
      "enum": [
        "EXACT",
        "SUPERSET"
      ]
    },
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "HOST_REVIEWED_EXECUTABLE"
        },
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "review_reference": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "status",
        "reviewer",
        "review_reference"
      ]
    },
    "coverage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "requirement_id": {
            "type": "string",
            "pattern": "^OREQ-[A-F0-9]{20}$"
          },
          "disposition": {
            "enum": [
              "COVERED",
              "PARTIAL",
              "UNSUPPORTED",
              "UNKNOWN"
            ]
          },
          "payload_kinds": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "payload_paths": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "prompt_rules": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "requirement_id",
          "disposition",
          "payload_kinds",
          "payload_paths",
          "prompt_rules",
          "rationale"
        ]
      }
    },
    "unmet_requirement_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^OREQ-[A-F0-9]{20}$"
      }
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "assessor": {
      "type": "string",
      "minLength": 1
    },
    "assessment_assurance": {
      "const": "HOST_ATTESTED"
    },
    "semantic_assurance": {
      "const": "UNQUALIFIED"
    },
    "frozen_at": {
      "$ref": "defs.schema.json#/$defs/iso_datetime"
    }
  },
  "required": [
    "schema_version",
    "resolution_id",
    "resolution_hash",
    "definition_artifact_id",
    "definition_id",
    "decision",
    "coverage",
    "unmet_requirement_ids",
    "rationale",
    "assessor",
    "assessment_assurance",
    "semantic_assurance",
    "frozen_at"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "const": "REUSE_EXISTING"
          }
        }
      },
      "then": {
        "required": [
          "selected_profile",
          "fit",
          "admission"
        ]
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "selected_profile"
              ]
            },
            {
              "required": [
                "fit"
              ]
            },
            {
              "required": [
                "admission"
              ]
            }
          ]
        }
      }
    }
  ]
}
