{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xhnovel.local/contracts/model-attempt.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "attempt_id",
    "operation",
    "subject_id",
    "request_artifact_id",
    "response_artifact_id",
    "attempt_ordinal",
    "status",
    "http_status",
    "error_code",
    "error_message",
    "provider_response_id",
    "usage",
    "retry_of",
    "recorded_at"
  ],
  "properties": {
    "schema_version": {"const": "0.2-draft"},
    "attempt_id": {"type": "string", "pattern": "^MAT-[A-Z0-9][A-Z0-9._:-]{1,}$"},
    "operation": {"const": "SCENE_SCOUT"},
    "subject_id": {"type": "string", "pattern": "^SWIN-[A-Z0-9][A-Z0-9._:-]{1,}$"},
    "request_artifact_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "response_artifact_id": {
      "anyOf": [
        {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        {"type": "null"}
      ]
    },
    "attempt_ordinal": {"type": "integer", "minimum": 1},
    "status": {"enum": ["SUCCEEDED", "RETRYABLE", "FAILED", "REFUSED", "REJECTED"]},
    "http_status": {"type": ["integer", "null"], "minimum": 100, "maximum": 599},
    "error_code": {"type": ["string", "null"]},
    "error_message": {"type": ["string", "null"]},
    "provider_response_id": {"type": ["string", "null"]},
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "total_tokens", "estimated_cost_microusd"],
      "properties": {
        "input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "total_tokens": {"type": ["integer", "null"], "minimum": 0},
        "estimated_cost_microusd": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "retry_of": {
      "anyOf": [
        {"type": "string", "pattern": "^MAT-[A-Z0-9][A-Z0-9._:-]{1,}$"},
        {"type": "null"}
      ]
    },
    "recorded_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
  }
}
