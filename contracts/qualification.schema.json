{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xhnovel.local/contracts/qualification.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "qualification_run_id",
    "extractor_build_id",
    "extractor_build_hash",
    "fixture_suite_hash",
    "run_a",
    "run_b",
    "run_a_hash",
    "run_b_hash",
    "run_a_result",
    "run_b_result",
    "adversarial_project_expectation",
    "source_content_injection",
    "reproducibility",
    "result",
    "qualified_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1-draft-frozen"
    },
    "qualification_run_id": {
      "type": "string",
      "pattern": "^QRUN-[A-Z0-9][A-Z0-9._:-]{1,}$"
    },
    "extractor_build_id": {
      "type": "string",
      "pattern": "^BLD-[A-Z0-9][A-Z0-9._:-]{1,}$"
    },
    "extractor_build_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "fixture_suite_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "run_a": {
      "type": "string"
    },
    "run_b": {
      "type": "string"
    },
    "run_a_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "run_b_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "run_a_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_id",
        "input_hash",
        "claims",
        "claim_set_hash",
        "result_hash"
      ],
      "properties": {
        "execution_id": {
          "type": "string",
          "minLength": 1
        },
        "input_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "claims": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "grade",
              "statement",
              "profile_schema",
              "profile_payload"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "ORIGINAL_FACT",
                  "RECEPTION"
                ]
              },
              "grade": {
                "enum": [
                  "CONFIRMED",
                  "SUPPORTED",
                  "INFERRED",
                  "UNKNOWN",
                  "CONFLICTING"
                ]
              },
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "profile_schema": {
                "type": "string",
                "minLength": 1
              },
              "profile_payload": {
                "type": "object"
              }
            }
          }
        },
        "claim_set_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "result_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "run_b_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_id",
        "input_hash",
        "claims",
        "claim_set_hash",
        "result_hash"
      ],
      "properties": {
        "execution_id": {
          "type": "string",
          "minLength": 1
        },
        "input_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "claims": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "grade",
              "statement",
              "profile_schema",
              "profile_payload"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "ORIGINAL_FACT",
                  "RECEPTION"
                ]
              },
              "grade": {
                "enum": [
                  "CONFIRMED",
                  "SUPPORTED",
                  "INFERRED",
                  "UNKNOWN",
                  "CONFLICTING"
                ]
              },
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "profile_schema": {
                "type": "string",
                "minLength": 1
              },
              "profile_payload": {
                "type": "object"
              }
            }
          }
        },
        "claim_set_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "result_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "adversarial_project_expectation": {
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "source_content_injection": {
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "reproducibility": {
      "enum": [
        "PASS",
        "INCONCLUSIVE"
      ]
    },
    "result": {
      "enum": [
        "PASS",
        "FAIL",
        "INCONCLUSIVE"
      ]
    },
    "qualified_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
