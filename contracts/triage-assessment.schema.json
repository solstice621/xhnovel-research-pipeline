{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xhnovel.local/contracts/triage-assessment.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "assessment_id",
    "retrieval_id",
    "tier",
    "technical_access",
    "rights",
    "source_quality",
    "assessor_build_id",
    "policy_hash",
    "assessed_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2-draft"
    },
    "assessment_id": {
      "type": "string",
      "pattern": "^TRI-[A-Z0-9][A-Z0-9._:-]{1,}$"
    },
    "retrieval_id": {
      "type": "string",
      "pattern": "^RET-[A-Z0-9][A-Z0-9._:-]{1,}$"
    },
    "tier": {
      "enum": [
        "A",
        "B",
        "C",
        "D"
      ]
    },
    "technical_access": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "succeeded"],
      "properties": {
        "method": {"enum": ["LOCAL_FILE", "ANONYMOUS_HTTP"]},
        "succeeded": {"const": true}
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "basis",
        "may_store_full_text",
        "may_send_to_external_model",
        "may_export_excerpts"
      ],
      "properties": {
        "basis": {
          "enum": [
            "USER_AUTHORIZED_LOCAL_COPY",
            "PUBLIC_DOMAIN",
            "LICENSED",
            "FAIR_USE_RESEARCH",
            "UNKNOWN"
          ]
        },
        "may_store_full_text": {"type": "boolean"},
        "may_send_to_external_model": {"type": "boolean"},
        "may_export_excerpts": {"type": "boolean"}
      }
    },
    "source_quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edition_status", "textual_completeness"],
      "properties": {
        "edition_status": {
          "enum": ["OFFICIAL", "PUBLISHED_EDITION", "USER_VERIFIED_COPY", "UNOFFICIAL_COPY", "UNKNOWN"]
        },
        "textual_completeness": {"enum": ["COMPLETE", "PARTIAL", "UNKNOWN"]}
      }
    },
    "suspected_reprint": {
      "type": "boolean"
    },
    "allowed_uses": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "selection_decision": {
      "type": "string"
    },
    "decision_reason": {
      "type": "string"
    },
    "assessor_build_id": {
      "type": "string"
    },
    "policy_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "assessed_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
