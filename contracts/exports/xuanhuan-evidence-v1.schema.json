{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xhnovel.local/contracts/exports/xuanhuan-evidence-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "export_id",
    "export_hash",
    "producer",
    "origin_request",
    "bundle",
    "scene_candidates",
    "scene_discovery",
    "policies",
    "assurance",
    "artifact_manifest",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2-draft"
    },
    "export_id": {
      "type": "string",
      "pattern": "^EXP-[A-Z0-9][A-Z0-9._:-]{1,}$"
    },
    "export_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_commit",
        "source_classifier_build_id",
        "parser_build_id",
        "scene_scout_build_id"
      ],
      "properties": {
        "repository_commit": {
          "type": "string",
          "minLength": 7
        },
        "source_classifier_build_id": {
          "type": "string"
        },
        "parser_build_id": {
          "type": "string"
        },
        "scene_scout_build_id": {
          "type": "string",
          "pattern": "^BLD-[A-Z0-9][A-Z0-9._:-]{1,}$"
        }
      }
    },
    "origin_request": {
      "$ref": "https://xhnovel.local/contracts/research-request.schema.json"
    },
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bundle_id",
        "bundle_hash"
      ],
      "properties": {
        "bundle_id": {
          "type": "string",
          "pattern": "^BND-[A-Z0-9][A-Z0-9._:-]{1,}$"
        },
        "bundle_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "scene_candidates": {
      "type": "array",
      "items": {
        "$ref": "https://xhnovel.local/contracts/scene-candidate.schema.json"
      }
    },
    "scene_discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scene_scout_run_id", "merge_run_id", "window_count", "candidate_count"],
      "properties": {
        "scene_scout_run_id": {"type": "string", "pattern": "^SSRUN-[A-Z0-9][A-Z0-9._:-]{1,}$"},
        "merge_run_id": {"type": "string", "pattern": "^SMRUN-[A-Z0-9][A-Z0-9._:-]{1,}$"},
        "window_count": {"type": "integer", "minimum": 0},
        "candidate_count": {"type": "integer", "minimum": 0}
      }
    },
    "policies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_bundle_hash"
      ],
      "properties": {
        "policy_bundle_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "assurance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level"
      ],
      "properties": {
        "level": {
          "enum": [
            "UNQUALIFIED",
            "BUILD_QUALIFIED",
            "BUNDLE_VERIFIED",
            "HUMAN_AUDITED"
          ]
        },
        "qualification_run_id": {
          "type": "string",
          "pattern": "^QRUN-[A-Z0-9][A-Z0-9._:-]{1,}$"
        },
        "auditability": {
          "enum": [
            "FULL",
            "DEGRADED",
            "LIMITED_BY_RETENTION_POLICY"
          ]
        }
      }
    },
    "artifact_manifest": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "byte_length",
          "durability_status",
          "availability"
        ],
        "properties": {
          "artifact_id": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "byte_length": {
            "type": "integer"
          },
          "durability_status": {
            "enum": [
              "EPHEMERAL",
              "LOCAL",
              "DURABLE"
            ]
          },
          "availability": {
            "enum": ["AVAILABLE", "WITHHELD_BY_RIGHTS"]
          }
        }
      }
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "revocation": {
      "type": [
        "object",
        "null"
      ]
    }
  }
}
