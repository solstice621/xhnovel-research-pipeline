{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xhnovel.local/contracts/novel-ranking-run.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ranking_run_id",
    "genre",
    "locale",
    "queries",
    "provider_windows",
    "pages_per_query",
    "results_per_page",
    "policy_id",
    "policy_artifact_id",
    "rrf_k",
    "score_scale",
    "candidates",
    "limitations",
    "status",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1-draft-frozen"
    },
    "ranking_run_id": {
      "type": "string",
      "pattern": "^NRNK-[A-Z0-9][A-Z0-9._:-]{1,}$"
    },
    "genre": {
      "type": "string",
      "minLength": 1
    },
    "locale": {
      "type": "string",
      "minLength": 1
    },
    "queries": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "provider_windows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "provider_id",
          "provider_build_id",
          "query",
          "page",
          "status",
          "raw_response_artifact_id",
          "hit_count",
          "error_code"
        ],
        "properties": {
          "provider_id": {
            "type": "string",
            "minLength": 1
          },
          "provider_build_id": {
            "type": "string",
            "minLength": 1
          },
          "query": {
            "type": "string",
            "minLength": 1
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "status": {
            "enum": [
              "SUCCEEDED",
              "FAILED"
            ]
          },
          "raw_response_artifact_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "hit_count": {
            "type": "integer",
            "minimum": 0
          },
          "error_code": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "pages_per_query": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "results_per_page": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "policy_id": {
      "const": "novel-fame-ranking-v1"
    },
    "policy_artifact_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "rrf_k": {
      "type": "integer",
      "minimum": 1
    },
    "score_scale": {
      "type": "integer",
      "minimum": 1
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_id",
          "title",
          "canonical_title",
          "aliases",
          "score",
          "signals",
          "rank"
        ],
        "properties": {
          "candidate_id": {
            "type": "string",
            "pattern": "^NCAN-[A-Z0-9][A-Z0-9._:-]{1,}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "canonical_title": {
            "type": "string",
            "minLength": 1
          },
          "aliases": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "score": {
            "type": "integer",
            "minimum": 0
          },
          "signals": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "provider_id",
                "provider_build_id",
                "query",
                "page",
                "rank",
                "global_rank",
                "title",
                "url",
                "raw_response_artifact_id",
                "rrf_points"
              ],
              "properties": {
                "provider_id": {
                  "type": "string",
                  "minLength": 1
                },
                "provider_build_id": {
                  "type": "string",
                  "minLength": 1
                },
                "query": {
                  "type": "string",
                  "minLength": 1
                },
                "page": {
                  "type": "integer",
                  "minimum": 1
                },
                "rank": {
                  "type": "integer",
                  "minimum": 1
                },
                "global_rank": {
                  "type": "integer",
                  "minimum": 1
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "url": {
                  "type": "string",
                  "minLength": 1
                },
                "raw_response_artifact_id": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "rrf_points": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          },
          "rank": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "status": {
      "enum": [
        "SUCCEEDED",
        "PARTIAL"
      ]
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
