{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xhnovel.local/contracts/parse-run.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "parse_run_id",
    "input_artifact_id",
    "parser_build_id",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2-draft"
    },
    "parse_run_id": {
      "type": "string",
      "pattern": "^PRUN-[A-Z0-9][A-Z0-9._:-]{1,}$"
    },
    "input_artifact_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "parser_build_id": {
      "type": "string"
    },
    "parameters": {
      "type": "object"
    },
    "output_document_id": {
      "type": "string",
      "pattern": "^DOC-[A-Z0-9][A-Z0-9._:-]{1,}$"
    },
    "output_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "status": {
      "enum": [
        "QUEUED",
        "RUNNING",
        "SUCCEEDED",
        "FAILED",
        "INCONCLUSIVE"
      ]
    },
    "retry_of": {
      "type": [
        "string",
        "null"
      ]
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
