{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xhnovel.local/contracts/novel-ingestion-run.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ingestion_run_id",
    "work_id",
    "adapter_build_id",
    "input_spec_hash",
    "input_spec_artifact_id",
    "chapter_ids",
    "ready_chapter_ids",
    "duplicate_chapter_ids",
    "provenance_artifact_ids",
    "checkpoint_hash",
    "checkpoint_artifact_id",
    "order_validation",
    "strict_order",
    "resumed_from_checkpoint",
    "status",
    "started_at",
    "finished_at",
    "retry_of"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1-draft-frozen"
    },
    "ingestion_run_id": {
      "type": "string",
      "pattern": "^NING-[A-Z0-9][A-Z0-9._:-]{1,}$"
    },
    "work_id": {
      "type": "string",
      "pattern": "^NWK-[A-Z0-9][A-Z0-9._:-]{1,}$"
    },
    "adapter_build_id": {
      "type": "string",
      "minLength": 1
    },
    "input_spec_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "input_spec_artifact_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "chapter_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^CHP-[A-Z0-9][A-Z0-9._:-]{1,}$"
      },
      "uniqueItems": true
    },
    "ready_chapter_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^CHP-[A-Z0-9][A-Z0-9._:-]{1,}$"
      },
      "uniqueItems": true
    },
    "duplicate_chapter_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^CHP-[A-Z0-9][A-Z0-9._:-]{1,}$"
      },
      "uniqueItems": true
    },
    "provenance_artifact_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      },
      "uniqueItems": true
    },
    "checkpoint_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "checkpoint_artifact_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "order_validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "out_of_order_chapter_ids",
        "missing_declared_numbers",
        "duplicate_chapter_ids"
      ],
      "properties": {
        "status": {
          "enum": [
            "PASS",
            "WARNING",
            "FAIL"
          ]
        },
        "out_of_order_chapter_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^CHP-[A-Z0-9][A-Z0-9._:-]{1,}$"
          },
          "uniqueItems": true
        },
        "missing_declared_numbers": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "uniqueItems": true
        },
        "duplicate_chapter_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^CHP-[A-Z0-9][A-Z0-9._:-]{1,}$"
          },
          "uniqueItems": true
        }
      }
    },
    "strict_order": {
      "type": "boolean"
    },
    "resumed_from_checkpoint": {
      "type": "boolean"
    },
    "status": {
      "enum": [
        "SUCCEEDED",
        "PARTIAL",
        "FAILED"
      ]
    },
    "started_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "finished_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "retry_of": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^NING-[A-Z0-9][A-Z0-9._:-]{1,}$"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
