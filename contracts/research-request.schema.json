{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xhnovel.local/contracts/research-request.schema.json",
  "title": "ResearchRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "origin",
    "mode",
    "discovery_brief",
    "search_constraints",
    "extraction_profile",
    "budget",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2-draft"
    },
    "request_id": {
      "type": "string",
      "pattern": "^REQ-[A-Z0-9][A-Z0-9._:-]{1,}$"
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "minLength": 7
        },
        "external_question_id": {
          "type": "string"
        }
      }
    },
    "mode": {
      "enum": [
        "EXPLORE",
        "DEEPEN",
        "CONFIRM",
        "CHALLENGE"
      ]
    },
    "discovery_brief": {
      "type": "string",
      "minLength": 1
    },
    "search_constraints": {
      "type": "object",
      "additionalProperties": true
    },
    "extraction_profile": {
      "type": "string",
      "minLength": 1
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_queries",
        "max_fetches"
      ],
      "properties": {
        "max_queries": {
          "type": "integer",
          "minimum": 1
        },
        "max_fetches": {
          "type": "integer",
          "minimum": 1
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
