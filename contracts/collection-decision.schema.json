{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xhnovel.local/contracts/collection-decision.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decision_id",
    "task",
    "subject_ids",
    "input_artifact_ids",
    "input_manifest_hash",
    "rubric_id",
    "rubric_artifact_id",
    "assessor_role",
    "assessor_build_id",
    "output_artifact_id",
    "outcome",
    "confidence",
    "basis",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2-draft"
    },
    "decision_id": {
      "type": "string",
      "pattern": "^CDEC-[A-Z0-9][A-Z0-9._:-]{1,}$"
    },
    "task": {
      "enum": [
        "TRIAGE",
        "CHAPTER_IDENTITY"
      ]
    },
    "subject_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "input_artifact_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    },
    "input_manifest_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "rubric_id": {
      "type": "string",
      "minLength": 1
    },
    "rubric_artifact_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "assessor_role": {
      "enum": [
        "COLLECTOR",
        "REVIEWER"
      ]
    },
    "assessor_build_id": {
      "type": "string",
      "minLength": 1
    },
    "output_artifact_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "model_request_artifact_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "provider_response_artifact_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "assessor_model": {
      "type": "string",
      "minLength": 1
    },
    "assessor_parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "endpoint",
        "max_input_chars",
        "structured_output",
        "task",
        "rubric_id",
        "rubric_hash",
        "task_schema_hash"
      ],
      "properties": {
        "endpoint": {
          "type": "string",
          "minLength": 1
        },
        "max_input_chars": {
          "type": "integer",
          "minimum": 1
        },
        "structured_output": {
          "const": true
        },
        "task": {
          "enum": ["TRIAGE", "CHAPTER_IDENTITY"]
        },
        "rubric_id": {
          "type": "string",
          "minLength": 1
        },
        "rubric_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "task_schema_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "disposition": {
          "enum": [
            "SELECTED",
            "REJECTED",
            "LEAD_ONLY",
            "QUARANTINED"
          ]
        },
        "tier": {
          "enum": [
            "A",
            "B",
            "C",
            "D"
          ]
        },
        "identity_status": {
          "enum": [
            "MATCH",
            "MISMATCH",
            "UNKNOWN",
            "QUARANTINED"
          ]
        }
      },
      "minProperties": 1
    },
    "confidence": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH"
      ]
    },
    "basis": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  },
  "dependentRequired": {
    "model_request_artifact_id": [
      "provider_response_artifact_id",
      "assessor_model",
      "assessor_parameters"
    ],
    "provider_response_artifact_id": [
      "model_request_artifact_id",
      "assessor_model",
      "assessor_parameters"
    ],
    "assessor_model": [
      "model_request_artifact_id",
      "provider_response_artifact_id",
      "assessor_parameters"
    ]
  }
}
