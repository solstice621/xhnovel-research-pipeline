{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xhnovel.local/contracts/parsed-document.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_id",
    "input_artifact_id",
    "parser_build_id",
    "structure_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1-draft-frozen"
    },
    "document_id": {
      "type": "string",
      "pattern": "^DOC-[A-Z0-9][A-Z0-9._:-]{1,}$"
    },
    "input_artifact_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "parser_build_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "language": {
      "type": "string"
    },
    "structure_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
